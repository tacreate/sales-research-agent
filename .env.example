# このファイルをコピーして .env を作成し、実際の値を設定する。
# .env はGit管理対象外（.gitignore参照）。実値をコミットしないこと。
#
#   cp .env.example .env
#
# N8N_HOST/N8N_PORT/N8N_PROTOCOL/TZ/GENERIC_TIMEZONE/
# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS はdocker-compose.ymlで固定値を設定済みのため、
# ここには含めない（秘密値・利用者固有の値のみをこのファイルで管理する）。

# --- n8n ---
# n8nの資格情報（Credentials）を暗号化するための鍵。ランダムな値を必ず自分で生成すること。
# 生成例（ローカルで実行し、出力された値を下記に貼り付ける。表示・共有・コミットしないこと）:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32

# --- OpenAI ---
# Responses APIを利用（HTTP RequestノードのAuthorizationヘッダーに使用）。Phase 2ではまだ設定不要。
OPENAI_API_KEY=

# --- Tavily ---
# Search / Extract APIの認証に使用。Phase 2ではまだ設定不要。
TAVILY_API_KEY=
