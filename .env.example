# このファイルをコピーして .env を作成し、実際の値を設定する。
# .env はGit管理対象外（.gitignore参照）。実値をコミットしないこと。
#
#   cp .env.example .env

# --- n8n ---
N8N_ENCRYPTION_KEY=changeme-generate-a-random-secret
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Tokyo

# --- OpenAI ---
# Responses APIを利用（HTTP RequestノードのAuthorizationヘッダーに使用）
OPENAI_API_KEY=

# --- Tavily ---
# Search / Extract APIの認証に使用
TAVILY_API_KEY=
